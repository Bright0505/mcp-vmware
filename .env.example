# vCenter 連線設定
VCENTER_HOST=vcenter.example.com
VCENTER_USER=administrator@vsphere.local
VCENTER_PASSWORD=changeme

# 設為 true 時關閉 TLS 憑證驗證(內部自簽憑證環境用),預設 false
VCENTER_INSECURE=false

# ── HTTP 模式(python -m http_server,Open WebUI 原生 MCP 連線用)──
# 共用 Bearer token,可逗號分隔多組(輪替用);未設＝不驗證(僅限本機除錯)
MCP_AUTH_TOKEN=
HTTP_PORT=8000
# HTTP_HOST=0.0.0.0
# MCP_SERVER_NAME=mcp-vmware          # /health 與 / 回傳的服務名稱
# MCP_ENABLE_DNS_PROTECTION=false      # 啟用 MCP SDK 的 DNS rebinding 防護

# ── 選用:OAuth access token 驗證(三者皆設定才啟用,僅作用於 /mcp)──
# MCP_OAUTH_ISSUER=https://auth.example.com/
# MCP_OAUTH_AUDIENCE=mcp-vmware
# MCP_OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# MCP_OAUTH_ALGORITHMS=RS256,ES256
# MCP_OAUTH_RESOURCE_METADATA_URL=https://mcp.example.com/.well-known/oauth-protected-resource
